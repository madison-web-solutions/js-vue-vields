# Logs
/log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Specific files / directories to ignore
package-lock.json
/node_modules
/dist
/dist-ssr
/coverage

# Ignore all hidden files...
/.*
# ....apart from the following exceptions
!/.gitattributes
!/.gitignore
!/.editorconfig
!/.vscode/extensions.json
!/.

# Demo app data (uploads and persisted db — not committed)
/demo/data/

# Standard system files to ignore
ehthumbs.db
Thumbs.db
.DS_Store
