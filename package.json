{
  "name": "vue-fields-ms",
  "version": "2.0.0-alpha.3",
  "repository": "github:madison-web-solutions/js-vue-vields",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./scss/variables": {
      "default": "./scss/variables.scss"
    },
    "./scss/main": {
      "default": "./scss/main.scss"
    },
    "./dist/HtmlField.css": {
      "default": "./dist/HtmlField.css"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --emitDeclarationOnly --outDir dist",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "ckeditor5": "^43.0.0",
    "date-format-ms": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.4",
    "@vitejs/plugin-vue": "^6.0.0",
    "bootstrap": "^5.3.8",
    "sass": "^1.77.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-svg-loader": "^5.1.0",
    "vue": "^3.5.17",
    "vue-tsc": "^2.2.10"
  },
  "files": [
    "dist/**/*",
    "scss/**/*"
  ]
}
