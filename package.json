{
  "name": "vue-fields-ms",
  "version": "2.0.0-alpha.11",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madison-web-solutions/js-vue-vields.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scss/variables": {
      "default": "./scss/variables.scss"
    },
    "./scss/main": {
      "default": "./scss/main.scss"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --emitDeclarationOnly --outDir dist",
    "type-check": "vue-tsc --noEmit",
    "demo:reset": "rm -rf demo/data",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ckeditor5": "^48.1.0",
    "date-format-ms": "^1.2.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.10",
    "bootstrap": "^5.3.8",
    "jsdom": "^27.0.1",
    "sass": "1.77.6",
    "sharp": "^0.34.5",
    "typescript": "^6.0.0",
    "vite": "^8.0.13",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.17",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.2.9"
  },
  "files": [
    "dist/**/*",
    "scss/**/*"
  ]
}
